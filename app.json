{
  "expo": {
    "name": "Nexus",
    "slug": "nexus-app",
    "version": "0.1.0",
    "orientation": "portrait",
    "icon": "./assets/icon.png",
    "userInterfaceStyle": "light",
    "ios": {
      "bundleIdentifier": "info.nexusglobal.app",
      "buildNumber": "1",
      "supportsTablet": false,
      "config": {
        "usesNonExemptEncryption": false
      }
    },
    "android": {
      "adaptiveIcon": {
        "backgroundColor": "#3E4A26",
        "foregroundImage": "./assets/android-icon-foreground.png",
        "backgroundImage": "./assets/android-icon-background.png",
        "monochromeImage": "./assets/android-icon-monochrome.png"
      },
      "predictiveBackGestureEnabled": false
    },
    "web": {
      "favicon": "./assets/favicon.png",
      "output": "single",
      "name": "Nexus App Demo",
      "shortName": "Nexus",
      "themeColor": "#3E4A26",
      "backgroundColor": "#3E4A26"
    },
    "plugins": [
      "expo-router",
      "expo-font",
      "expo-sqlite",
      "expo-web-browser",
      [
        "expo-image-picker",
        {
          "photosPermission": "Nexus uses your photos so you can add them to your profile, posts and private messages. Only the photos you pick are uploaded.",
          "cameraPermission": false,
          "microphonePermission": false
        }
      ],
      [
        "expo-splash-screen",
        {
          "image": "./assets/splash-icon.png",
          "imageWidth": 220,
          "backgroundColor": "#F7EDE4",
          "resizeMode": "contain"
        }
      ]
    ],
    "scheme": "nexus",
    "backgroundColor": "#F2EEE4",
    "experiments": {
      "baseUrl": "/nexus-app",
      "typedRoutes": true
    }
  }
}
